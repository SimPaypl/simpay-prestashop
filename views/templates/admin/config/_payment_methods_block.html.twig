
<div id="simpay-methods-block" class="form-group row d-none">
    <div class="alert alert-info w-100">
        {{ 'If the payment method you are looking for is not available, you can add and activate it in the SimPay panel in the "Payment channels" section.'|trans({}, 'Modules.Simpay.Admin') }}
    </div>
    <label class="form-control-label" for="form_show_payment_methods_in_main">{{ 'Payment methods list'|trans({}, 'Modules.Simpay.Admin') }}</label>
    <div class="col-sm">
        <div class="row mb-3 align-items-stretch">
            <div class="col-md-6">
                <h4 class="h5">{{ 'All payment methods'|trans({}, 'Modules.Simpay.Admin') }}</h4>
                <ul id="simpay-all-methods" class="list-group simpay-sortable">
                    {% for method in availableMethods %}
                        <li class="list-group-item d-flex justify-content-between align-items-center" data-name="{{ method.name }}" data-id="{{ method.id }}">
                            <span>{{ method.name }}</span>
                            <i class="material-icons text-muted">drag_indicator</i>
                        </li>

                    {% endfor %}
                </ul>
            </div>

            <div class="col-md-6">
                <h4 class="h5">{{ 'Selected methods'|trans({}, 'Modules.Simpay.Admin') }}</h4>
                <ul id="simpay-selected-methods" class="list-group simpay-sortable">
                    {% for id, name in selectedMethods %}
                        <li class="list-group-item d-flex justify-content-between align-items-center" data-name="{{ name|e('html_attr') }}" data-id="{{ id|e('html_attr') }}">
                            <span>{{ name|e('html_attr') }}</span>
                            <i class="material-icons text-muted">drag_indicator</i>
                        </li>

                    {% endfor %}
                </ul>
            </div>
        </div>
        <button
                type="button"
                class="btn btn-outline-primary btn-sm"
                id="simpay-refresh-channels"
        >
            <i class="material-icons" style="font-size:18px; vertical-align:middle;">refresh</i>
            {{ 'Refresh channels'|trans({}, 'Modules.Simpay.Admin') }}
        </button>
        <small class="form-text">{{ 'Drag and drop payment methods to change their order.'|trans({}, 'Modules.Simpay.Admin') }}</small>
    </div>
</div>